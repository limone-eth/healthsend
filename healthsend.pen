        {
          "type": "frame",
          "id": "LvCDL",
          "name": "Section",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "l9FfY",
              "name": "Section Head",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "LaI5V",
                  "name": "Title",
                  "fill": "$ink",
                  "content": "Expiry — the one new primitive",
                  "fontFamily": "$font-ui",
                  "fontSize": 28,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "e2ibq",
                  "name": "Desc",
                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": 820,
                  "content": "Every other component in this file already exists. Expiry does not, because Omea has nothing that ends. The Countdown reads a real Swarm batch TTL and an Arkiv ExpiresIn — it is never a UI timer counting down against a stored date. It appears in exactly three places: on a send in the sender's live view, in the recipient's header, and on an agent grant. It carries three states and the word changes with the colour, every time.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "AhvL7",
                  "name": "Rule",
                  "fill": "$hairline",
                  "width": "fill_container",
                  "height": 1
                }
              ]
            },
            {
              "type": "frame",
              "id": "b7nB5",
              "name": "Body",
