                {
                  "type": "frame",
                  "id": "f6VDsV",
                  "name": "Rules",
                  "width": "fill_container",
                  "fill": "$grouped",
                  "cornerRadius": 16,
                  "layout": "vertical",
                  "gap": 14,
                  "padding": 22,
                  "children": [
                    {
                      "type": "text",
                      "id": "j2Pwcj",
                      "name": "Title",
                      "fill": "$ink",
                      "content": "Rules for the connector",
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
                      "id": "p5LB01",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "dcU5y",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "Q1nBA0",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Re-installing must never re-pair. The connector's own keypair lives in the user's app data, outside the bundle, so an update replaces code and nothing else. Get this wrong and every release costs every user a re-pair, which is the worst outcome available.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "MxKaE",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "XGLTO",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "sNebG",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Never ask anyone to re-pair to change a scope or a date. Pairing is once per machine, ever. A flow that pairs twice has broken the promise it is selling.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "DgNPL",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "Hmc1P",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "I8MoLq",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "An unknown group is skipped and named, never fatal. The connector reads what it understands, and the interface says which groups it could not — on the share, in words, with the group names in them.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "F687i3",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "jTTyb",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "A1JDmY",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "An update is never blocking and never a modal. It is a state on a version row, at most a dot on the rail item. Nobody is locked out of a working connection to install a nicety.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Pp5YJ",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "rlaVu",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "LgTmr",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The update prompt says what survives it — the connection, the scope, the dates — because the fear it has to answer is losing the thing that already works.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "kIciD",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "YE8Zd",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "iywDP",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Prefer a new share over a new build. If a capability can be expressed as a scope the connector already knows how to render, ship it as a share and nobody downloads anything.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
