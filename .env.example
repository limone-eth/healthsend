# Gas faucet for user-derived Arkiv grant keys. Fund at https://hub.arkiv.network/faucet
ARKIV_FUNDER_PRIVATE_KEY=

# Optional: gateway that stamps uploads for identities with no postage batch.
NEXT_PUBLIC_SWARM_SUBSIDISED_GATEWAY=

# Optional overrides.
NEXT_PUBLIC_SWARM_ID_ORIGIN=https://swarm-id.snaha.net
NEXT_PUBLIC_SWARM_GATEWAY=https://download.gateway.ethswarm.org
NEXT_PUBLIC_ARKIV_RPC=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Synthetic-data TACo PoC only. Current TACo docs say no supported active
# infrastructure (see the TACo PoC plan's "Global Constraints"). All of these
# values are public — none is a private key or an Arkiv access token, because
# NEXT_PUBLIC_TACO_COORDINATION_RPC ends up embedded in permanent ciphertext.
NEXT_PUBLIC_TACO_ENABLED=false
NEXT_PUBLIC_TACO_DOMAIN=lynx
NEXT_PUBLIC_TACO_RITUAL_ID=27
NEXT_PUBLIC_TACO_COORDINATION_RPC=https://polygon-amoy.drpc.org
# Optional comma-separated override; omit to use the SDK's domain discovery.
NEXT_PUBLIC_TACO_PORTER_URIS=

# Lit Chipotle PoC, against Lit's real API (https://api.chipotle.litprotocol.com/core/v1,
# hardcoded in lib/key-release/chipotle.ts — there is only one Chipotle service,
# so there is nothing here to override). An enclave service (TEE-derived key),
# never described as decentralised, trustless, or a threshold network — see
# docs/stories/H-65.md. A worker cannot create this account, mint a usage key,
# or register the Lit Action (see scripts/chipotle-print-action-cid.mjs); leave
# these empty and set them once that exists. The usage key is a *restricted*,
# execute-only key scoped to one group that permits exactly one action CID,
# meant to ship to the browser for walletless recipients — never the account's
# master key, which must never appear here or in any commit.
NEXT_PUBLIC_CHIPOTLE_ENABLED=false
# IPFS CID of the registered action (lib/key-release/chipotle-action.js).
NEXT_PUBLIC_CHIPOTLE_ACTION_CID=
# GET /list_wallets' `id` field for the PKP this adapter uses.
NEXT_PUBLIC_CHIPOTLE_PKP_ID=
# GET /list_groups' `id` field for the group scoping the usage key below.
NEXT_PUBLIC_CHIPOTLE_GROUP_ID=
NEXT_PUBLIC_CHIPOTLE_USAGE_API_KEY=

# The key-share holder. Required — without it a send can be created but never
# opened, because the holder keeps one half of every content key.
#
# Production uses Upstash. Locally, `pnpm holder:up` runs a Redis behind an
# Upstash-REST shim (see docker-compose.dev.yml) so the same client and the same
# Lua scripts run in both places, and these two values are what point at it:
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=healthsend-local-dev-token
