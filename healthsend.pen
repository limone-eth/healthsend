            {
              "type": "text",
              "id": "R0iIvP",
              "name": "Lede",
              "fill": "$secondary",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "The persistent frame around the product, and one fully composed screen showing the tokens working together at real density. The tab bar is glass at 38% — it is the one piece of chrome that must stay legible over anything the member scrolls beneath it.",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 17,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "SIFkZ",
          "name": "Navigation and chrome",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 28,
          "children": [
            {
              "type": "frame",
