                          "type": "text",
                          "id": "kxc9x",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Days down to 48 hours, then hours. Never minutes or seconds — except the demo clock, which is labelled a demo control and lives outside the component.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "rn3L9",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "hUiU0",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "j7Pm3",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Expiry is never red. $error is reserved for End access now, the one destructive action in the product. An expired grant is a completed relationship, not a failure.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "P1AaFJ",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "YZA0T",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "JYHY3",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The state word changes with the colour, every time — Active, Closing, Expired. Legible in greyscale, the same three-signal rule Sheet 2 applies to selection.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
