                          "id": "BvYcV",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The figure comes from the batch TTL and the grant's ExpiresIn. Never a client-side timer counting against a stored date — if the number can drift from the cryptography, the product's central claim becomes decoration.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "w5Nq2",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "xG4Ep",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "i0cMGs",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Never a progress bar, ring or depleting meter. A draining gauge reads as a resource someone could top up; this is a date, and dates are read, not filled.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "egsEN",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
