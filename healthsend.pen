                    },
                    {
                      "type": "text",
                      "id": "zKWg0",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Type colour is set by the tier, not by taste — white on Transparent, Inputs and Tab Bar; Carbon on Share + Filters.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "W8Cy74",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Hairlines invert: $hairline on paper becomes $glass-hairline over media.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "h9dZFL",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Shadow and blur are alternatives, never a stack. Moving onto glass means removing the shadow.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "kJ7hh",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  One blur per group. A glass list blurs once; its rows do not blur individually.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nSvWq",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Nothing else changes — no new radius, no new spacing, no new component.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
