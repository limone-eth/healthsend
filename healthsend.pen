                      "type": "text",
                      "id": "FiPEi",
                      "name": "Title",
                      "fill": "$ink",
                      "content": "Rules for every chart",
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
                      "id": "CYvzr",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "ehw1k",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "nPkhg",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "One hue. Comparisons to a previous period use the same navy as an outline, never a second colour — a quiet product does not get a second data hue for free.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "UZtR4",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "qk0S9",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "lj3td",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Never two y-scales on one chart. Two measures of different size are two charts, or one indexed to a common base.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "mnjJP",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "Lnew0",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "tnmd0",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The target line is drawn, not implied. Colour splits at the threshold and a hairline marks it, so 'under target' survives greyscale.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "fZXKH",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "s0Cju",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "R9Rqy4",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Range and metric are two separate controls, and the form is derived from the range rather than offered as a third choice. Nobody should have to pick a chart type.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "gKFrP",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "DuZvH",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "UdnTI",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Every axis is labelled at its ends and at most three points between. Recessive $muted at 11pt, never a gridline behind every bar.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "rGSfe",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "hIjXr",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "LfBuU",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Values live in text tokens, never in the series colour. A swatch beside a number carries the identity.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "J6NvBQ",
                      "name": "Rule",
                      "width": "fill_container",
                      "gap": 10,
                      "children": [
                        {
                          "type": "text",
                          "id": "XCZWG",
                          "name": "Bullet",
                          "fill": "$muted",
                          "content": "·",
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "sGDp7",
                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The recipient's page gets the bar and the threshold bar only. Exploration belongs to the person who owns the data — §10 puts recipient dashboards on the cut list, and that still holds.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "C8IXL",
          "name": "Section",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "ZaY2u",
              "name": "Section Head",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "ZjCwi",
                  "name": "Title",
                  "fill": "$ink",
                  "content": "No photography",
                  "fontFamily": "$font-ui",
                  "fontSize": 28,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "cD1qh",
                  "name": "Desc",
                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": 820,
                  "content": "The one deliberate break with the parent kit. Omea earns its photography — it is a wellness product and the imagery is the mood. HealthSend shows somebody's thyroid results to their nutritionist, and stock imagery behind that reads as decoration at best and as a lifestyle brand handling clinical data at worst. So the photography goes, and with it most of the glass ladder: glass only works over something worth seeing through to, and paper is not that.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "LpNC5",
                  "name": "Rule",
                  "fill": "$hairline",
                  "width": "fill_container",
                  "height": 1
                }
              ]
            },
            {
              "type": "frame",
              "id": "RLUH9",
              "name": "Body",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 34,
