                          "id": "X8Zta",
                          "name": "Cell",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": 530,
                          "content": "No rail, no tab bar, no account control, no way further into the product.",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "V3yMW",
                          "name": "Cell",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": 740,
                          "content": "She is not a user of an app yet. Anything that looks like navigation invites her to look for more than she was given.",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
