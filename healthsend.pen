                      "id": "L5cOz",
                      "name": "Label",
                      "fill": "$ink",
                      "content": "Rules for glass",
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "NNTnR",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Blur radius is 24 at every tier. The opacity changes, the blur does not.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "SBi5Y",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Never stack two glass tiers directly on one another — the second reads as dirt, not depth.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "pmzVi",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Type on Transparent, Inputs and Tab Bar is white; on Share + Filters it is Carbon. There is no in-between case.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "T4AyHA",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Where an image is dark or busy enough to break legibility, add a scrim beneath the glass rather than raising the tier.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "b0ZM1",
                      "name": "Rule",
                      "fill": "$secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Glass carries no colour of its own. If a surface needs a hue, it is not glass — use a tint from the palette above.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
