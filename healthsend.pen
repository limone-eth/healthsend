                          "name": "Text",
                          "fill": "$secondary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Expired is a state of the whole surface, not a badge on a live one. When a grant lapses the recipient page becomes the expired page; the data never renders behind a notice.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
