                      ]
                    },
                    {
                      "type": "frame",
                      "id": "a4XqOB",
                      "name": "Notes",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "T0N8vb",
                          "name": "WHAT REPLACES IT",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 6,
                          "children": [
                            {
                              "type": "text",
                              "id": "RzfPb",
                              "name": "Label",
                              "fill": "$navy",
                              "content": "WHAT REPLACES IT",
                              "fontFamily": "$font-ui",
                              "fontSize": 11,
                              "fontWeight": "600",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "eKDwt",
                              "name": "Body",
                              "fill": "$secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "One gradient, used at most once per screen, and only where the parent kit would have put photography: the archive's status surface and the whole ended page. Everywhere else is paper — $canvas ground, $surface cards, $hairline rules. Most screens now have no focus surface at all, and are better for it.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-ui",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "IPtyK",
                          "name": "PANELS OVER THE GRADIENT",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 6,
                          "children": [
                            {
                              "type": "text",
                              "id": "o4ZnD",
                              "name": "Label",
                              "fill": "$navy",
                              "content": "PANELS OVER THE GRADIENT",
                              "fontFamily": "$font-ui",
                              "fontSize": 11,
                              "fontWeight": "600",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "t8Tdp",
                              "name": "Body",
                              "fill": "$secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "A flat white-alpha panel — $panel-on-dark at a $hairline-on-dark border — and no blur. A gradient is not media: there is nothing behind it to see through to, so a backdrop blur would render as a slightly paler rectangle pretending to be glass.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-ui",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "NHsF7",
                          "name": "WHAT SURVIVES OF THE GLASS LADDER",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 6,
                          "children": [
                            {
                              "type": "text",
                              "id": "yyoyL",
                              "name": "Label",
                              "fill": "$navy",
                              "content": "WHAT SURVIVES OF THE GLASS LADDER",
                              "fontFamily": "$font-ui",
                              "fontSize": 11,
                              "fontWeight": "600",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "n6rrqf",
                              "name": "Body",
                              "fill": "$secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "One tier, one use: $glass-raised under the mobile bottom bar, where real content scrolls beneath it. Sheet 1's four tiers stay documented because the parent kit owns them, but $glass-transparent, $glass-input and $glass-tabbar have no callers in this product.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-ui",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "vxd8I",
                          "name": "WHY THE ENDED PAGE IS DARK",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 6,
                          "children": [
                            {
                              "type": "text",
                              "id": "fEky4",
                              "name": "Label",
                              "fill": "$navy",
                              "content": "WHY THE ENDED PAGE IS DARK",
                              "fontFamily": "$font-ui",
                              "fontSize": 11,
                              "fontWeight": "600",
                              "letterSpacing": 1.4
                            },
                            {
                              "type": "text",
                              "id": "YVauL",
                              "name": "Body",
                              "fill": "$secondary",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "It is the only page in the product that inverts, which is the point — an ended share should be unmistakable from across a room, before a word is read. Light page means readings; dark page means there is nothing to read.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-ui",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "r62RSr",
          "name": "Section",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 28,
          "children": [
            {
              "type": "frame",
              "id": "E0zXE",
              "name": "Section Head",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "j5pQK",
                  "name": "Title",
                  "fill": "$ink",
                  "content": "The life of a share",
                  "fontFamily": "$font-ui",
                  "fontSize": 28,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "Qwwq9",
                  "name": "Desc",
                  "fill": "$secondary",
                  "textGrowth": "fixed-width",
                  "width": 820,
                  "content": "A share has six states. They render as Chips from Sheet 2 — no new component, only a fixed vocabulary and a fixed mapping onto the existing fills. Two have no equivalent in Omea: On her device, which records that a link tied itself to one phone, and Ended by you, the only state a person's action produces. The label is what the user reads, so it is written in plain language; the mechanism sits in the right-hand column, for us.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "BmzfN",
                  "name": "Rule",
