                          "textGrowth": "fixed-width",
                          "width": 740,
                          "content": "She opens it on her phone from a message. Building it at phone width and centring it in a desktop window costs nothing; building it desktop-first and squeezing it costs the one flow that has to feel effortless.",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-ui",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
